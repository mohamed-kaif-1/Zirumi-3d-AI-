# Server only. Never prefix secrets with VITE_. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional two-letter language hint. Empty means automatic language detection.
GROQ_STT_LANGUAGE=
TRANSCRIPTION_PORT=3001
# Optional comma-separated exact HTTPS origins for an authenticated reverse proxy.
# The backend remains bound to loopback. No wildcard CORS is enabled.
ZIRUMI_ALLOWED_ORIGINS=

# Server only. Obtain your account key from ElevenLabs; never use VITE_ for it.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Cloud replies require assigned ElevenLabs voices. Optional browser fallback only affects replies, never previews.
ELEVENLABS_FALLBACK=none
# Only enable for accounts authorized for ElevenLabs enterprise zero retention.
ELEVENLABS_ZERO_RETENTION=false

# Aira keeps her existing browser voice until an exact account-accessible ID is supplied.
AIRA_VOICE_ID=

# Phase 1 primary providers. Catalog UUIDs must be distinct and account-accessible.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_API_VERSION=2026-08-14
CARTESIA_VOICE_AIRA=
CARTESIA_VOICE_LUNA=
CARTESIA_VOICE_MIRA=
CARTESIA_VOICE_ZYRA=
# Explicit switches: STT deepgram/groq/browser; TTS cartesia/elevenlabs/browser.
# Existing installations retain their chosen legacy settings during verification.
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_LLM_PROVIDER=groq
DEFAULT_TTS_PROVIDER=cartesia
DEFAULT_LANGUAGE=en

# Optional per-browser Mem0 consent remains off until explicitly enabled.
MEM0_API_KEY=
MEMORY_ENABLED=false
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Explicit locale models; Tamil v3 preserves documented feminine voices.
SARVAM_TTS_MODEL_TA=bulbul:v3
SARVAM_TTS_MODEL_HI=bulbul:v4-flash
SARVAM_TTS_MODEL_EN=bulbul:v4-flash
# Optional explicit Groq alternatives; blank uses GROQ_CHAT_MODEL, never auto-fallback.
GROQ_CHAT_MODEL_TA=
GROQ_CHAT_MODEL_HI=
GROQ_CHAT_MODEL_EN=
# Optional voice overrides: SARVAM_VOICE_AIRA/LUNA/MIRA/ZYRA_TA/HI/EN.
# Each value must belong to its documented locale/model catalog; four voices stay distinct.
